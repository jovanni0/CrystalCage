ktor:
    deployment:
        port: 7489
        discovery_port: 7490
    application:
        modules:
            - dev.jovanni0.ApplicationKt.module
jwt:
    secret: "replace-with-a-real-secret-from-env"
    issuer: "crystalcage-server"
    audience: "crystalcage-client"
    realm: "crystalcage"
database:
    jdbc_url: "jdbc:postgresql://localhost:5432/crystalcage"
    username: "postgres"
    password: "postgres"
storage:
  baseDirectory: "./crystalcage-fs"

server:
    # the name of the server that will be shown in the client app.
    name: Sanctum Example Server

    # indicates the server is behind a secure connection, required for client-side auto-discovery.
    # if wrong, the server will be detected but the users will not be able to log in because of a SSL_PROTOCOL_ERROR.
    https: true