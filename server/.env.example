PORT=7489
DISCOVERY_PORT=7490

JWT_SECRET=replace-with-a-real-secret-from-env
JWT_ISSUER=sanctum-server
JWT_AUDIENCE=sanctum-client
JWT_REALM=sanctum

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sanctum
DB_JDBC_URL=jdbc:postgresql://db:5432/sanctum

STORAGE_BASE_DIR=./sanctum-fs

# host folders (outside the container)
SANCTUM_FS_DIR=/srv/data/apps/sanctum/fs
SANCTUM_DB_DIR=/opt/appdata/sanctum/postgres

SERVER_NAME="Sanctum Server"
SERVER_HTTPS=false
SEED_ADMIN_PASSWORD=secret-password